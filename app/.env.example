# API base URL for the app (no trailing slash).
#
# - Web via gateway (:26261) or tunnel: leave UNSET (same-origin requests work).
# - iOS simulator: http://localhost:26261  (localhost = your Mac)
# - Physical iPhone on same Wi-Fi: http://<MAC_LAN_IP>:26261
#   find it with: ipconfig getifaddr en0
EXPO_PUBLIC_API_BASE=http://localhost:26261
